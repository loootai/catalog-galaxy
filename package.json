{
  "name": "catalog-galaxy",
  "version": "0.1.0",
  "description": "3D map of the looot data API catalog: categories as clusters, platforms as stars, jobs with prices. Static site built with Three.js.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "snapshot": "node scripts/snapshot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "bash scripts/leak-scan.sh ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loootai/catalog-galaxy.git"
  },
  "homepage": "https://loootai.github.io/catalog-galaxy/"
}
